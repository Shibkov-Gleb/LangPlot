{
  "name": "@langplot/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx --env-file=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "admin:invite": "tsx --env-file=../../.env src/owner-invite.ts",
    "content": "tsx --env-file=../../.env src/cli.ts"
  },
  "dependencies": {
    "@langplot/shared": "workspace:*",
    "@langplot/agents": "workspace:*",
    "@prisma/client": "6.19.2",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "dotenv-cli": "11.0.0",
    "prisma": "6.19.2"
  }
}
