  "scenes": [
    {
      "id": "arrival",
      "text": "У стойки кафе Оуэн ставит варежку на блюдце, как пирожное. Хозяйка Джо пододвигает пустое блюдце ему. Это старый семейный розыгрыш. Оуэн улыбается раньше, чем замечает бирку внутри.",
      "phase": "arrival",
      "layout": "arrival",
      "resourceId": "diner",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-1",
          "setFlags": {}
        }
      ]
    },
    {
      "id": "line-1",
      "text": "One red glove. Do you want a fork with that?",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "diner",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-2",
          "setFlags": {}
        }
      ],
      "speakerId": "jo",
      "portraitId": "jo"
    },
    {
      "id": "line-2",
      "text": "Only if you have two.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "diner",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-3",
          "setFlags": {}
        }
      ],
      "speakerId": "owen",
      "portraitId": "owen"
    },
    {
      "id": "line-3",
      "text": "Who lost it?",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "diner",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-4",
          "setFlags": {}
        }
      ],
      "speakerId": "lev"
    },
    {
      "id": "line-4",
      "text": "Dot used to put her name inside everything. Look under the little white line.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "diner",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-5",
          "setFlags": {}
        }
      ],
      "speakerId": "jo",
      "portraitId": "jo"
    },
    {
      "id": "line-5",
      "text": "Don't pull. My sister did that by hand.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "diner",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-6",
          "setFlags": {}
        }
      ],
      "speakerId": "owen",
      "portraitId": "owen"
    },
    {
      "id": "line-6",
      "text": "It says K. It doesn't say Dot.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "diner",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-7",
          "setFlags": {}
        }
      ],
      "speakerId": "lev"
    },
    {
      "id": "line-7",
      "text": "Good. Keep telling me what it says.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "diner",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
