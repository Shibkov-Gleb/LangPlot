  "scenes": [
    {
      "id": "arrival",
      "text": "Мастерская дяди. Илья вытирает две чистые кружки и оставляет грязную на подоконнике. Внутри лежат винты. На запасном ключе пластырь с буквой L.",
      "phase": "arrival",
      "layout": "arrival",
      "resourceId": "workshop",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-1",
          "setFlags": {}
        }
      ]
    },
    {
      "id": "line-1",
      "text": "You got taller. Your mother said you didn't.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "workshop",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-2",
          "setFlags": {}
        }
      ],
      "speakerId": "ilya",
      "portraitId": "ilya"
    },
    {
      "id": "line-2",
      "text": "She sees me every day.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "workshop",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-3",
          "setFlags": {}
        }
      ],
      "speakerId": "lev"
    },
    {
      "id": "line-3",
      "text": "I put your key on the table. This place is yours for a week.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "workshop",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-4",
          "setFlags": {}
        }
      ],
      "speakerId": "ilya",
      "portraitId": "ilya"
    },
    {
      "id": "line-4",
      "text": "And after a week?",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "workshop",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-5",
          "setFlags": {}
        }
      ],
      "speakerId": "lev"
    },
    {
      "id": "line-5",
      "text": "After a week I sell the shop. I thought I told you.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "workshop",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-6",
          "setFlags": {}
        }
      ],
      "speakerId": "ilya",
      "portraitId": "ilya"
    },
    {
      "id": "line-6",
      "text": "You said you needed help. That's different.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "workshop",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "line-7",
          "setFlags": {}
        }
      ],
      "speakerId": "lev"
    },
    {
      "id": "line-7",
      "text": "Yes. It is.",
      "phase": "dialogue",
      "layout": "line",
      "resourceId": "workshop",
      "marks": [],
      "choices": [
        {
          "id": "next",
          "label": "Дальше",
          "target": "grammar",
          "setFlags": {}
        }
      ],
      "speakerId": "ilya",
      "portraitId": "ilya"
    },
    {
