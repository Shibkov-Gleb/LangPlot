{
  "name": "langplot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node --env-file=.env node_modules/concurrently/dist/bin/concurrently.js -k -n api,web -c cyan,magenta \"pnpm --filter @langplot/api dev\" \"pnpm --filter @langplot/web dev\"",
    "preview": "node --env-file=.env node_modules/concurrently/dist/bin/concurrently.js -k -n api,web \"pnpm --filter @langplot/api start\" \"pnpm --filter @langplot/web start\"",
    "build": "pnpm --filter @langplot/api build && pnpm --filter @langplot/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e": "playwright test",
    "db:up": "node scripts/docker.mjs up -d --wait",
    "db:down": "node scripts/docker.mjs down",
    "db:local": "node scripts/local-postgres.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @langplot/api db:generate",
    "db:migrate": "pnpm --filter @langplot/api db:migrate",
    "db:studio": "pnpm --filter @langplot/api db:studio",
    "admin:invite": "pnpm --filter @langplot/api admin:invite",
    "content": "pnpm --filter @langplot/api content",
    "tts": "pnpm --filter @langplot/api tts"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.11",
    "concurrently": "9.2.1",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
